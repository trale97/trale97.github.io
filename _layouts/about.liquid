---
layout: default
---
{% comment %}
  Local override of al_folio_core's about layout.
  Two-column profile hero (photo + name + icons | bio + CV button + interests + education),
  followed by the usual news / latest posts / selected publications sections.
  Hero content is set in the front matter of _pages/about.md.
{% endcomment %}
<div class="post">
  <article>
    <section class="hero">
      <div class="hero-side">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          <div class="hero-photo">
            {%
              include figure.liquid loading="eager" path=profile_image_path class="img-fluid" sizes="200px" alt=page.profile.image
              cache_bust=true
            %}
          </div>
        {% endif %}

        <h1 class="hero-name">{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}</h1>
        {% if page.profile.role %}<p class="hero-role">{{ page.profile.role }}</p>{% endif %}
        {% if page.profile.affiliation %}<p class="hero-affiliation">{{ page.profile.affiliation }}</p>{% endif %}

        {% if page.social %}
          <div class="social hero-social">
            <div class="contact-icons">{% social_links %}</div>
          </div>
        {% endif %}
      </div>

      <div class="hero-main">
        <h2 class="hero-heading">About Me</h2>
        <div class="hero-bio">{{ content }}</div>

        {% if page.profile.cv %}
          <a class="hero-cv" href="{{ page.profile.cv | relative_url }}" target="_blank" rel="noopener">
            <i class="fa-solid fa-download"></i> Download CV
          </a>
        {% endif %}

        {% if page.interests or page.education %}
          <div class="hero-lists">
            {% if page.interests %}
              <div>
                <h3>Interests</h3>
                <ul class="hero-interests">
                  {% for item in page.interests %}
                    <li>{{ item }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            {% if page.education %}
              <div>
                <h3>Education</h3>
                <ul class="hero-education">
                  {% for edu in page.education %}
                    <li>
                      <i class="fa-solid fa-graduation-cap"></i>
                      <div>
                        <div class="edu-degree">{{ edu.degree }}{% if edu.year %}, {{ edu.year }}{% endif %}</div>
                        <div class="edu-institution">{{ edu.institution }}</div>
                      </div>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </section>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center_margin.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  </article>
</div>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 2rem 0 2.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--global-divider-color);
  }
  @media (min-width: 768px) {
    .hero {
      grid-template-columns: 240px 1fr;
      gap: 3rem;
      padding-top: 3rem;
    }
  }

  /* Left column */
  .hero-side {
    text-align: center;
  }
  .hero-photo {
    width: 200px;
    height: 200px;
    margin: 0 auto 1rem;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--global-text-color);
  }
  .hero-photo figure,
  .hero-photo picture {
    margin: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-name {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.35rem;
  }
  .hero-role {
    font-weight: 600;
    margin: 0 0 0.15rem;
  }
  .hero-affiliation {
    color: var(--global-text-color-light);
    font-size: 0.95rem;
    margin: 0 0 0.75rem;
  }
  .hero-social .contact-icons {
    font-size: 1.5rem;
    line-height: 1.2;
  }
  .hero-social .contact-icons a {
    margin: 0 0.15rem;
  }
  .hero-social .contact-icons a i::before {
    color: var(--global-text-color);
  }
  .hero-social .contact-icons a img {
    width: 1.3rem;
    height: 1.3rem;
    margin-bottom: 0.25rem;
  }
  .hero-social .contact-icons a svg {
    width: 1.4rem;
    height: 1.5rem;
    margin-bottom: 0.25rem;
  }
  .hero-social .contact-icons a svg image {
    width: 1.4rem;
    height: 1.4rem;
  }

  /* Right column */
  .hero-heading {
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0 0 1rem;
  }
  .hero-bio p:last-child {
    margin-bottom: 0;
  }
  .hero-cv {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--global-text-color);
    border-radius: 0.375rem;
    color: var(--global-text-color) !important;
    font-size: 0.95rem;
    text-decoration: none !important;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .hero-cv:hover {
    background: var(--global-text-color);
    color: var(--global-bg-color) !important;
  }
  .hero-lists {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  @media (min-width: 576px) {
    .hero-lists {
      grid-template-columns: 1fr 1fr;
    }
  }
  .hero-lists h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
  }
  .hero-interests {
    margin: 0;
    padding-left: 1.25rem;
  }
  .hero-interests li {
    margin-bottom: 0.35rem;
  }
  .hero-education {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hero-education li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    margin-bottom: 0.75rem;
  }
  .hero-education i {
    margin-top: 0.3rem;
    width: 1.1rem;
    text-align: center;
  }
  .edu-institution {
    color: var(--global-text-color-light);
    font-size: 0.9rem;
  }
</style>
